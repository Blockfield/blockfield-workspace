      "allow_exact": [
        "Deadmau5EarsLayer",
        "SubscribeC2SPacket",
        "Xvfb-linux-amd64",
        "OpenJDK21U-jdk_x64_linux_hotspot_21",
        "OpenJDK21U-jdk_aarch64_linux_hotspot_21",
        "OpenJDK21U-jdk_x64_windows_hotspot_21",
