      "paths": ["**"],
      "regex": true,
      "pattern": "(?<![A-Za-z0-9_@.:\\-])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[0-9])(?![A-Za-z0-9_-]*[Ss]ha256)(?!(?:0[xX])?[0-9a-fA-F]+(?![A-Za-z0-9_-]))(?P<tok>[A-Za-z0-9_-]{16,})(?![A-Za-z0-9_@\\-])",
      "allow_exact": [
